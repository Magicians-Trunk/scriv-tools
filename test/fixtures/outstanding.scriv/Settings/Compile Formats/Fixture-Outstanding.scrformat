<?xml version="1.0" encoding="UTF-8"?>
<CompileFormat Name="Fixture Outstanding" ID="F2000000-0000-4000-8000-000000000001">
    <SupportedTypes>
        <Type>mmd</Type>
    </SupportedTypes>
    <SectionLayouts>
        <Layout Name="Plain" ID="E2000000-0000-4000-8000-000000000001">
            <Include Titles="Yes" Text="Yes"/>
            <Separators UseDefault="Yes"/>
        </Layout>
        <Layout Name="Heading" ID="E2000000-0000-4000-8000-000000000002">
            <Include Titles="Yes"/>
            <Separators UseDefault="Yes"/>
        </Layout>
        <Layout Name="Metadata" ID="E2000000-0000-4000-8000-000000000003">
            <Include Titles="Yes" MetaData="Yes" Text="Yes"/>
            <Separators UseDefault="Yes"/>
        </Layout>
        <Layout Name="Title Prefix" ID="E2000000-0000-4000-8000-000000000004">
            <Include Titles="Yes" Text="Yes"/>
            <Titles>
                <Prefix>Chapter &lt;$n:chapter&gt;: </Prefix>
                <Suffix> (end)</Suffix>
            </Titles>
            <Separators UseDefault="Yes"/>
        </Layout>
        <Layout Name="Two Hashes" ID="E2000000-0000-4000-8000-000000000005">
            <Include Titles="Yes" Text="Yes"/>
            <Titles>
                <MMDHashCount>2</MMDHashCount>
            </Titles>
            <Separators UseDefault="Yes"/>
        </Layout>
        <Layout Name="No Hashes" ID="E2000000-0000-4000-8000-000000000006">
            <Include Titles="Yes" Text="Yes"/>
            <Titles>
                <MMDHashCount>0</MMDHashCount>
                <Prefix>[</Prefix>
                <Suffix>]</Suffix>
            </Titles>
            <Separators UseDefault="Yes"/>
        </Layout>
        <Layout Name="Uppercase" ID="E2000000-0000-4000-8000-000000000007">
            <Include Titles="Yes" Text="Yes"/>
            <Titles>
                <TitleCase>Uppercase</TitleCase>
            </Titles>
            <Separators UseDefault="Yes"/>
        </Layout>
        <Layout Name="Run In" ID="E2000000-0000-4000-8000-000000000008">
            <Include Titles="Yes" Text="Yes"/>
            <Titles>
                <RunInHead>Yes</RunInHead>
                <Suffix>. </Suffix>
            </Titles>
            <Separators UseDefault="Yes"/>
        </Layout>
        <Layout Name="Hashes Inside" ID="E2000000-0000-4000-8000-000000000009">
            <Include Titles="Yes" Text="Yes"/>
            <Titles>
                <Prefix>&gt; </Prefix>
                <Suffix HashesInside="Yes"> &lt;</Suffix>
            </Titles>
            <Separators UseDefault="Yes"/>
        </Layout>
        <Layout Name="Page Break" ID="E2000000-0000-4000-8000-000000000010">
            <Include Titles="Yes" Text="Yes"/>
            <Separators UseDefault="No">
                <Before Type="PageBreak"/>
                <Between Type="PageBreak"/>
                <AfterOverride Use="No" Type="Single"/>
            </Separators>
        </Layout>
        <Layout Name="Custom Break" ID="E2000000-0000-4000-8000-000000000011">
            <Include Titles="Yes" Text="Yes"/>
            <Separators UseDefault="No">
                <Before Type="Custom">@ Before @</Before>
                <Between Type="Custom">@ Between @</Between>
                <AfterOverride Use="No" Type="Single"/>
            </Separators>
        </Layout>
        <Layout Name="After Override" ID="E2000000-0000-4000-8000-000000000012">
            <Include Titles="Yes" Text="Yes"/>
            <Separators UseDefault="No">
                <Before Type="Single"/>
                <Between Type="Single"/>
                <AfterOverride Use="Yes" Type="PageBreak"/>
            </Separators>
        </Layout>
        <Layout Name="Padding" ID="E2000000-0000-4000-8000-000000000013">
            <Include Titles="Yes" Text="Yes"/>
            <PagePadding>2</PagePadding>
            <Separators UseDefault="Yes"/>
        </Layout>
        <Layout Name="Upper Words" ID="E2000000-0000-4000-8000-000000000014">
            <Include Titles="Yes" Text="Yes"/>
            <UppercasedFirstWords>2</UppercasedFirstWords>
            <Separators UseDefault="Yes"/>
        </Layout>
